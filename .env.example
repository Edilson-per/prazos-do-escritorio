# Copie para .env e preencha UMA das opções. Sem nada, roda em modo demonstração.

# Opção A — Vertex AI (recomendado com dados reais de clientes)
# Requer: pip install google-genai  e  gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=southamerica-east1

# Opção B — Gemini API com chave de conta PAGA (o plano gratuito pode usar os dados)
# GEMINI_API_KEY=

# Modelo (opcional)
# GEMINI_MODEL=gemini-flash-latest

# PORTA=8765
